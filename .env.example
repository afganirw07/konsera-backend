# DATABASE CONFIGURATION
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=konsera
DB_SSLMODE=disable

# SMTP CONFIGURATION
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_smtp_password

# JWT CONFIGURATION
JWT_SECRET=your_jwt_secret

# CORS CONFIGURATION (comma-separated; leave empty to allow all origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# IMAGE UPLOAD CONFIGURATION
IMAGE_UPLOAD_PATH=https://api.imgbb.com/1/upload
IMAGE_UPLOAD_API_KEY=YOUR_IMGBB_API_KEY

# MIDTRANS PAYMENT GATEWAY (sandbox by default)
MIDTRANS_KEY_NAME=Konsera_Payment
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false
# Optional endpoint overrides
# MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
# MIDTRANS_CORE_URL=https://api.sandbox.midtrans.com
