{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Authenticate a user with email and password, then return a JWT access token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Login user",
                "parameters": [
                    {
                        "description": "Login credentials",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/konsera-backend_internal_DTO_user.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "schema": {
                            "$ref": "#/definitions/konsera-backend_internal_DTO_user.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request or credentials",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "description": "Create a new user with the provided information",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Create a new user",
                "parameters": [
                    {
                        "description": "User information",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/konsera-backend_internal_DTO_user.CreateUserRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "User created successfully",
                        "schema": {
                            "$ref": "#/definitions/konsera-backend_internal_DTO_user.UserResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request or email/phone already exists",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/auth/resend-otp": {
            "post": {
                "description": "Resend the OTP code for user account activation",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Resend OTP",
                "parameters": [
                    {
                        "description": "Resend OTP information",
                        "name": "otp",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/konsera-backend_internal_DTO_user.ResendOTPRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OTP resent successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request or failed to resend OTP",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/auth/verify-otp": {
            "post": {
                "description": "Verify the OTP code for user account activation",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Verify OTP",
                "parameters": [
                    {
                        "description": "OTP verification information",
                        "name": "otp",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/konsera-backend_internal_DTO_user.VerifyOTPRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OTP verified successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request or OTP verification failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/auth/verify-otp/{profile_id}/{code}": {
            "post": {
                "description": "Verify the OTP code for user account activation using path parameters",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Verify OTP via Path Parameters",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Profile ID",
                        "name": "profile_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "OTP Code",
                        "name": "code",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OTP verified successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request or OTP verification failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/users/preferences": {
            "post": {
                "description": "Create user preference for a specific user",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Create User Preference",
                "parameters": [
                    {
                        "description": "User preference information",
                        "name": "preference",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/konsera-backend_internal_DTO_user.CreateUserPreferenceRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "User preference created successfully",
                        "schema": {
                            "$ref": "#/definitions/konsera-backend_internal_DTO_user.UserPreferenceResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request or failed to create user preference",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "konsera-backend_internal_DTO_user.CreateUserPreferenceRequest": {
            "type": "object",
            "required": [
                "favorite_genres",
                "user_id"
            ],
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "favorite_genres": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "marketing_opt_in": {
                    "type": "boolean"
                },
                "notify_email": {
                    "type": "boolean"
                },
                "notify_push": {
                    "type": "boolean"
                },
                "notify_sms": {
                    "type": "boolean"
                },
                "updated_at": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "konsera-backend_internal_DTO_user.CreateUserRequest": {
            "type": "object",
            "required": [
                "email",
                "full_name",
                "password",
                "phone"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "full_name": {
                    "type": "string",
                    "minLength": 2
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                },
                "phone": {
                    "type": "string"
                }
            }
        },
        "konsera-backend_internal_DTO_user.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                }
            }
        },
        "konsera-backend_internal_DTO_user.LoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/konsera-backend_internal_DTO_user.UserResponse"
                }
            }
        },
        "konsera-backend_internal_DTO_user.ResendOTPRequest": {
            "type": "object",
            "required": [
                "profile_id"
            ],
            "properties": {
                "profile_id": {
                    "type": "string"
                }
            }
        },
        "konsera-backend_internal_DTO_user.UserPreferenceResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "favorite_genres": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "marketing_opt_in": {
                    "type": "boolean"
                },
                "notify_email": {
                    "type": "boolean"
                },
                "notify_push": {
                    "type": "boolean"
                },
                "notify_sms": {
                    "type": "boolean"
                },
                "updated_at": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "konsera-backend_internal_DTO_user.UserResponse": {
            "type": "object",
            "properties": {
                "auth_provider": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "phone": {
                    "type": "string"
                },
                "profile_id": {
                    "type": "string"
                },
                "provider_uid": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "konsera-backend_internal_DTO_user.VerifyOTPRequest": {
            "type": "object",
            "required": [
                "code",
                "profile_id"
            ],
            "properties": {
                "code": {
                    "type": "integer"
                },
                "profile_id": {
                    "type": "string"
                }
            }
        }
    }
}